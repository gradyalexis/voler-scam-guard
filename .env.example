# ---------------------------------------------------------------------------
# Salin jadi .env lalu isi. JANGAN commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DB_NAME=voler_scam_guard
DB_USER=vsg
DB_PASSWORD=ganti-dengan-password-acak-panjang
# Port Postgres di host (loopback saja). Ganti kalau 5433 sudah dipakai.
DB_PORT=5433
# Password role read-only (vsg_ro) yang dipakai scripts/db-read.sh.
DB_RO_PASSWORD=ganti-dengan-password-acak-lain
# Dipakai kalau menjalankan bot/dashboard di luar docker compose.
# Di dalam compose, DATABASE_URL di-inject otomatis (host: postgres).
DATABASE_URL=postgres://vsg:ganti-dengan-password-acak-panjang@localhost:5433/voler_scam_guard

# --- Discord bot -----------------------------------------------------------
# Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Developer Portal -> OAuth2 -> Client Secret (dipakai login dashboard)
DISCORD_CLIENT_SECRET=
# User ID kamu — selalu boleh pakai slash command admin. Pisahkan dengan koma.
BOT_OWNER_IDS=

# --- Perilaku bot ----------------------------------------------------------
# Mode default untuk server yang belum diatur: auto_delete | warn | flag_only | off
DEFAULT_MODE=flag_only
LOG_LEVEL=info
# 'eng' lebih cepat; 'eng+ind' lebih akurat untuk teks bahasa Indonesia.
OCR_LANGS=eng+ind
OCR_MAX_IMAGE_BYTES=8388608
OCR_MAX_IMAGES_PER_MESSAGE=3
# Pindai QR code di dalam gambar; isi QR ikut dicek link, blacklist, dan heuristiknya.
SCAN_QR_CODES=true

# --- Google Safe Browsing (opsional, gratis) -------------------------------
# console.cloud.google.com -> aktifkan "Safe Browsing API" -> buat API key.
# Kalau dikosongkan, deteksi URL hanya memakai blacklist lokal.
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Dashboard -------------------------------------------------------------
# Domain publik dashboard, dipakai Caddy untuk menerbitkan sertifikat.
DASHBOARD_DOMAIN=scamguard.domainkamu.com
ACME_EMAIL=kamu@email.com
# Harus URL lengkap dan sama persis dengan redirect URI di Discord OAuth2:
#   https://scamguard.domainkamu.com/api/auth/callback
DASHBOARD_URL=https://scamguard.domainkamu.com
# Kunci penandatangan cookie sesi. Buat dengan: openssl rand -base64 48
AUTH_SECRET=
# Discord user ID yang otomatis jadi owner saat pertama login (bootstrap admin).
BOOTSTRAP_ADMIN_DISCORD_IDS=
