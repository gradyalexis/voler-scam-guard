# ---------------------------------------------------------------------------
# Salin jadi .env lalu isi. JANGAN commit .env.
#   cp .env.example .env
# Dashboard punya .env sendiri di repo voler-scam-guard-dashboard.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# supabase : Postgres di Supabase (disarankan)
# local    : container postgres di docker compose — isi juga bagian "local" di bawah
DB_PROVIDER=supabase

# Supabase -> Connect -> Session pooler. Formatnya:
#   postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# - Password yang berisi @ : / ? # % harus di-URL-encode.
# - Jangan tambahkan ?sslmode=... — SSL diatur lewat DATABASE_SSL_CA_FILE.
DATABASE_URL=
# CA cert Supabase (Project Settings -> Database -> SSL Configuration ->
# Download certificate). Path relatif ke root project. Wajib untuk host Supabase.
DATABASE_SSL_CA_FILE=certs/supabase-ca.crt
# Batas koneksi pool bot. Total dengan DASHBOARD_DB_POOL_MAX (repo dashboard)
# harus di bawah "Pool Size" pooler Supabase (Project Settings -> Database ->
# Connection pooling).
BOT_DB_POOL_MAX=5

# Password role read-only (vsg_ro) untuk scripts/db-read.sh.
# Hanya huruf/angka/_/- :  openssl rand -hex 24
DB_RO_PASSWORD=

# --- Hanya untuk DB_PROVIDER=local -----------------------------------------
# Untuk mode local: aktifkan baris-baris ini, ubah DATABASE_URL di atas jadi
# postgres://vsg:<DB_PASSWORD>@localhost:5433/voler_scam_guard (dipakai saat
# bot jalan di luar docker) dan kosongkan DATABASE_SSL_CA_FILE.
# COMPOSE_PROFILES=local-db
# DB_NAME=voler_scam_guard
# DB_USER=vsg
# DB_PASSWORD=ganti-dengan-password-acak-panjang
# DB_PORT=5433
# Di dalam compose host-nya `postgres`, bukan localhost:
# COMPOSE_DATABASE_URL=postgres://vsg:ganti-dengan-password-acak-panjang@postgres:5432/voler_scam_guard

# --- Discord bot -----------------------------------------------------------
# Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# WAJIB. Discord user ID pemilik bot, pisahkan dengan koma. Bot hanya tinggal di
# server tempat salah satu ID ini owner / Administrator / Manage Server; server
# lain otomatis ditinggalkan (saat diundang dan saat bot start). Samakan dengan
# BOT_OWNER_IDS di .env dashboard.
BOT_OWNER_IDS=

# --- Perilaku bot ----------------------------------------------------------
# Mode default untuk server yang belum diatur:
#   auto_delete | warn_delete | warn | flag_only | off
DEFAULT_MODE=flag_only
LOG_LEVEL=info
# Port endpoint health (GET /health) di dalam container. Kalau diubah,
# sesuaikan juga port mapping bot di docker-compose.yml. 0 = matikan.
HEALTH_PORT=9000
# 'eng' lebih cepat; 'eng+ind' lebih akurat untuk teks bahasa Indonesia.
OCR_LANGS=eng+ind
OCR_MAX_IMAGE_BYTES=8388608
OCR_MAX_IMAGES_PER_MESSAGE=3
# Pindai QR code di dalam gambar; isi QR ikut dicek link, blacklist, dan heuristiknya.
SCAN_QR_CODES=true

# --- Google Safe Browsing (opsional, gratis) -------------------------------
# console.cloud.google.com -> aktifkan "Safe Browsing API" -> buat API key.
# Kalau dikosongkan, deteksi URL hanya memakai blacklist lokal.
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Review gambar AI (opsional) -------------------------------------------
# Gambar yang lolos pemeriksaan lokal tapi punya tanda mencurigakan (link, QR,
# pola scam) dinilai AI. Nyalakan per server lewat dashboard (Setting bot). Penyedia dicoba berurutan: semua model Gemini,
# lalu Groq, lalu OpenRouter. Key kosong = penyedia itu dilewati; semua kosong =
# fitur mati. Di free tier, data yang dikirim boleh dipakai untuk melatih model.
#
# Gemini: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Model: lihat ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
# Dicoba berurutan kalau model utama sibuk (503) atau kuotanya habis (429).
# Kuota free tier dihitung per model, jadi cadangan juga menambah kuota harian.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Groq: console.groq.com/keys. Model harus mendukung gambar (console.groq.com/docs/vision).
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b
# OpenRouter: openrouter.ai/keys. Model gratis berakhiran :free; tanpa top-up
# kuotanya 50 request/hari untuk semua model gratis. `openrouter/free` memilih
# sendiri model gratis yang sedang kosong. Model gratis populer (mis. gemma)
# sering kena rate limit hulu karena kuotanya dipakai bersama semua pengguna.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,openrouter/free
# Batas lokal jumlah gambar yang dinilai AI (semua penyedia digabung).
AI_MAX_PER_MINUTE=10
AI_MAX_PER_DAY=300
